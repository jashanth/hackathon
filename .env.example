# Copy to .env for local development. Git ignores .env; never commit real hashes.

# --- Admin console ---------------------------------------------------------------------
# Generate a private password hash with: npm run hash-admin-password
ADMIN_ACCOUNTS_JSON='[{"email":"admin@example.edu","name":"Hackathon Organizer","passwordHash":"scrypt$<salt-hex>$<128-hex-hash>"}]'

# Set to true only behind a proxy that appends the client address to X-Forwarded-For.
# TRUST_PROXY=true

# --- Registration ----------------------------------------------------------------------
# SUBMISSION_ENABLED=true
# REGISTRATION_MIN_TEAM_SIZE=2
# REGISTRATION_MAX_TEAM_SIZE=4
