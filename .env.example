# Copy to .env for local development. Git ignores .env; never commit real hashes.

# --- Admin console ---------------------------------------------------------------------
# Generate a private password hash with: npm run hash-admin-password
ADMIN_ACCOUNTS_JSON='[{"email":"saivaibhavaluguri@gmail.com","name":"Aluguri SaiVaibhav","passwordHash":"scrypt$<salt-hex>$<128-hex-hash>"},{"email":"jashanthgonipati@gmail.com","username":"jashanth","name":"Jashanth Gonipati","passwordHash":"scrypt$<salt-hex>$<128-hex-hash>"}]'

# Optional admin session absolute limit in hours. Default: unset (no expiry).
# If unset or 0, sessions stay valid until logout, clear-admin-sessions, or password change.
# ADMIN_SESSION_MAX_HOURS=24

# Public origin for CSRF and same-origin verification
PUBLIC_ORIGIN=https://hackathon.cybersec-kgrcet.com

# Set to true only behind a proxy that appends the client address to X-Forwarded-For.
# TRUST_PROXY=true

# --- Registration ----------------------------------------------------------------------
# SUBMISSION_ENABLED=true
# REGISTRATION_MIN_TEAM_SIZE=2
# REGISTRATION_MAX_TEAM_SIZE=4
